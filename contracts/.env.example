# A checkout needs no environment at all: `forge build` and `forge test` read nothing.
# Everything here is for deploying. Never put a private key in this file.

# Verifies the deployment on Optimistic Etherscan.
ETHERSCAN_API_KEY=

# An OP Mainnet RPC, for the fork rehearsal and the deployment. The README's
# commands pass it as --rpc-url $OP_RPC, which the shell expands, so export it in
# the shell. Forge loading this file does not do that.
OP_RPC=

# The address of the key that signs the deployment. The README's commands pass
# it as --sender $DEPLOYER and copy it into TREASURY_OWNER, so export it in the
# shell too.
DEPLOYER=

# script/Deploy.s.sol reads these. The Deploy section of README.md says what each
# must be. They are left commented out so an empty value never reaches a run.
# TREASURY_OWNER=
# BENEFICIARY=
# SALE_START=
# ALLOW_EOA_TREASURY_OWNER=
# ALLOW_EOA_BENEFICIARY=
